{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "courses": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "tasks": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "classification": {
                  "enum": [
                    "GK",
                    "EK",
                    "TEST",
                    "M",
                    null
                  ],
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "due": {
                  "minimum": 0,
                  "type": "integer"
                },
                "name": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "assignment",
                    "quiz"
                  ]
                }
              },
              "required": [
                "name",
                "description",
                "due",
                "type"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "tasks"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "courses"
  ],
  "title": "EduPlanner Demo Courses",
  "type": "object"
}
