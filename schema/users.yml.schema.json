{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "password": {
      "minLength": 1,
      "type": "string"
    },
    "users": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "student"
                }
              }
            },
            "then": {
              "properties": {
                "class": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "class"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "teacher"
                }
              }
            },
            "then": {
              "properties": {
                "task-status": {
                  "maxProperties": 0
                }
              }
            }
          }
        ],
        "properties": {
          "class": {
            "type": [
              "string",
              "null"
            ]
          },
          "courses": {
            "items": {
              "enum": [
                "mathematics",
                "physics",
                "literature",
                "computer_science"
              ],
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "enum": [
              "student",
              "teacher"
            ]
          },
          "task-status": {
            "additionalProperties": false,
            "properties": {
              "computer_science.algorithms_quiz": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Algorithms Quiz (computer_science)",
                "type": "string"
              },
              "computer_science.capstone_project": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Capstone Project (computer_science)",
                "type": "string"
              },
              "computer_science.data_structures": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Data Structures (computer_science)",
                "type": "string"
              },
              "computer_science.intro_to_programming": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Intro to Programming (computer_science)",
                "type": "string"
              },
              "literature.final_exam": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Final Exam (literature)",
                "type": "string"
              },
              "literature.modern_novel_essay": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Modern Novel Essay (literature)",
                "type": "string"
              },
              "literature.poetry_analysis": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Poetry Analysis (literature)",
                "type": "string"
              },
              "literature.research_presentation": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Research Presentation (literature)",
                "type": "string"
              },
              "mathematics.algebra_foundations": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Algebra Foundations (mathematics)",
                "type": "string"
              },
              "mathematics.derivatives": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Derivatives (mathematics)",
                "type": "string"
              },
              "mathematics.final_exam": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Final Exam (mathematics)",
                "type": "string"
              },
              "mathematics.integrals": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Integrals (mathematics)",
                "type": "string"
              },
              "mathematics.midterm_exam": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Midterm Exam (mathematics)",
                "type": "string"
              },
              "physics.electricity_and_magnetism": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Electricity and Magnetism (physics)",
                "type": "string"
              },
              "physics.final_exam": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Final Exam (physics)",
                "type": "string"
              },
              "physics.mechanics": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Mechanics (physics)",
                "type": "string"
              },
              "physics.waves_and_optics": {
                "enum": [
                  "submitted",
                  "completed"
                ],
                "title": "Waves and Optics (physics)",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "name",
          "role",
          "courses"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "password",
    "users"
  ],
  "title": "EduPlanner Demo Users",
  "type": "object"
}
